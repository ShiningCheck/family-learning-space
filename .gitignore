# ===== 个人数据层（永不入库）=====
# 本机数据区配置（含本机绝对路径，指向仓库外的 data-root）
local.json
# 家庭私有内容（真名/学校/班级等一律不入库）；真实数据统一落在仓库外的 data-root
personal/
# 各技能的真实运行数据（config、学情报告、课表、通知、录音、打卡等）；匿名模板在 data-templates/
.trae/skills/*/data/
# 教材库（版权内容，统一落在仓库外 data-root；仓库内这份是迁移前的残留，防误提交）
textbooks/
# 孩子画作档案（画作图片、录音、描述、生成的画册）
画作档案/
.trae/skills/xiaoshan-art-archive/images/
.trae/skills/xiaoshan-art-archive/audio/
.trae/skills/xiaoshan-art-archive/output/
# 家庭图书馆的图书封面照片（个人藏书照片）
.trae/skills/home-library/images/
# 由书包清单技能生成的内嵌个人数据单文件
school_checklist_standalone.html
# 任何内嵌真实数据的分享单文件（一律不入库；要分享请用 tools/build_dist.py 打包）
*_standalone.html

# ===== 构建产物与分享包（打包后可能内嵌个人数据，永不入库）=====
# 发布包一律由 tools/build_dist.py 现场生成，不进版本库
dist/
.trae-html-share-packages/

# ===== 本机 AI 会话/记忆痕迹（含真名、学校等，永不入库）=====
.workbuddy/

# ===== 门户接线的自动备份（可随时回退，不入库）=====
.portal-wire-backup/

# ===== 超大版权教材（不入库，用 tools/ 下载脚本自行获取）=====
# （已由上面的 textbooks/ 统一覆盖）

# ===== 工具脚本的调试中间产物 =====
tools/detail.html
tools/detail_yuwen.json
tools/grade1_books.json
tools/target_books.json

# ===== 反馈中转服务（Cloudflare Worker）=====
# 本地开发用的密钥文件与依赖，绝不能入库
feedback-relay/.dev.vars
feedback-relay/node_modules/
feedback-relay/.wrangler/

# ===== 通用 =====
__pycache__/
*.pyc
*.log
.DS_Store
Thumbs.db
